@rendermode InteractiveServer
@inject IJSRuntime Js

@code {
    public const string Stylesheet = "/css/modern-color-layout.css?v=22";
    public const string Script = "/js/modern-color-layout.js?v=11";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Js.InvokeVoidAsync("ScriptLoader.ensureLoaded", Script);
                await Js.InvokeVoidAsync("ModernColorLayout.initBlazor");
            }
            catch (JSException ex)
            {
                await Js.InvokeVoidAsync("console.error", "ModernColorLayout 初始化失败。", ex.Message);
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }
}
