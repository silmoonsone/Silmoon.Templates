@implements IAsyncDisposable
@inject IJSRuntime Js

<div @ref="PickerElement" class="date-range-picker" data-date-time-range-picker>
    <button class="date-range-trigger" type="button" title="选择@(RangeUnit)范围：全部时段" aria-label="选择@(RangeUnit)范围：全部时段" aria-haspopup="dialog" aria-controls="@PickerId" aria-expanded="false" data-date-range-open>
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M7 3v4m10-4v4M3 10h18M7 14h3m4 0h3m-10 4h3" /></svg>
    </button>
    <dialog id="@PickerId" class="date-range-dialog" aria-labelledby="@(PickerId + "-title")" aria-describedby="@(PickerId + "-hint")" data-date-range-dialog>
        <div data-date-range-form>
            <header class="date-range-header">
                <h2 id="@(PickerId + "-title")">选择@(RangeUnit)范围</h2>
                <button class="date-range-close" type="button" aria-label="取消并关闭" data-date-range-cancel>×</button>
            </header>
            <div class="date-range-presets" role="group" aria-label="快捷时间范围">
                <button type="button" data-date-range-preset="today">今天</button>
                <button type="button" data-date-range-preset="yesterday">昨天</button>
                <button type="button" data-date-range-preset="threeDays">近三天</button>
                <button type="button" data-date-range-preset="thisWeek">本周</button>
                <button type="button" data-date-range-preset="lastWeek">上周</button>
                <button type="button" data-date-range-preset="thisMonth">本月</button>
                <button type="button" data-date-range-preset="lastMonth">上月</button>
                <button type="button" data-date-range-preset="threeMonths">三个月</button>
                <button type="button" data-date-range-preset="sixMonths">半年</button>
                <button type="button" data-date-range-preset="oneYear">一年</button>
                <button type="button" data-date-range-preset="all">全部</button>
            </div>
            <div class="date-range-fields">
                <label for="@(PickerId + "-start")">开始@(RangeUnit)<input id="@(PickerId + "-start")" type="@(IncludeTime ? "datetime-local" : "date")" step="@(IncludeTime ? "0.001" : "1")" min="@(IncludeTime ? "0001-01-01T00:00" : "0001-01-01")" max="@(IncludeTime ? "9999-12-31T23:59:59.999" : "9999-12-31")" data-date-range-start /></label>
                <label for="@(PickerId + "-end")">结束@(RangeUnit)<input id="@(PickerId + "-end")" type="@(IncludeTime ? "datetime-local" : "date")" step="@(IncludeTime ? "0.001" : "1")" min="@(IncludeTime ? "0001-01-01T00:00" : "0001-01-01")" max="@(IncludeTime ? "9999-12-31T23:59:59.999" : "9999-12-31")" data-date-range-end /></label>
            </div>
            <p id="@(PickerId + "-hint")" class="date-range-hint">@(IncludeTime ? "按本机时区选择，包含结束时间；点击确定后生效。" : "按本机时区选择，包含开始与结束日期全天；点击确定后生效。")</p>
            <p class="date-range-error" role="alert" data-date-range-error hidden></p>
            <footer class="date-range-actions">
                <button class="date-range-secondary" type="button" data-date-range-cancel>取消</button>
                <button class="date-range-primary" type="button" data-date-range-apply>确定</button>
            </footer>
        </div>
    </dialog>
</div>

@code {
    [Parameter]
    public bool IncludeTime { get; set; } = true;
    [Parameter] public DateTimeRangeValue? Value { get; set; }
    [Parameter] public EventCallback<DateTimeRangeValue?> ValueChanged { get; set; }
    [Parameter] public bool JavaScriptManaged { get; set; }

    string RangeUnit => IncludeTime ? "时间" : "日期";
    string PickerId { get; } = "date-range-" + Guid.NewGuid().ToString("N");
    ElementReference PickerElement { get; set; }
    IJSObjectReference? JsModule { get; set; }
    IJSObjectReference? Picker { get; set; }
    DotNetObjectReference<DateTimeRangePicker>? CallbackReference { get; set; }
    SemaphoreSlim LifecycleLock { get; } = new(1, 1);
    bool? InitialJavaScriptManaged { get; set; }
    bool MountedIncludeTime { get; set; }
    bool Applying { get; set; }
    bool Disposed { get; set; }

    protected override void OnParametersSet()
    {
        if (InitialJavaScriptManaged.HasValue && InitialJavaScriptManaged != JavaScriptManaged) throw new InvalidOperationException("JavaScriptManaged cannot change on an existing picker. Use @key to recreate the component when changing ownership.");
        InitialJavaScriptManaged = JavaScriptManaged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await LifecycleLock.WaitAsync();
        try
        {
            if (Disposed || Applying) return;
            if (JavaScriptManaged)
            {
                await DisposePickerAsync();
                return;
            }
            JsModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "./Components/DateTimeRangePicker.razor.js?v=3");
            if (Disposed) return;
            var includeTime = IncludeTime;
            if (Picker is not null && MountedIncludeTime != includeTime) await DisposePickerAsync();
            if (Picker is null)
            {
                CallbackReference ??= DotNetObjectReference.Create(this);
                Picker = await Js.InvokeAsync<IJSObjectReference>("DateTimeRangePicker.mountBlazor", PickerElement, CallbackReference);
                MountedIncludeTime = includeTime;
            }
            if (!Applying) await Picker.InvokeVoidAsync("setValue", Value);
        }
        catch (JSDisconnectedException) { }
        finally { LifecycleLock.Release(); }
    }

    [JSInvokable]
    public async Task<bool> ApplyRangeAsync(DateTimeRangeValue? value)
    {
        if (Disposed || JavaScriptManaged || Applying) return false;
        if (value is not null && value.StartTime > value.EndTime) return false;
        if (value is not null) value = value with { StartTime = value.StartTime.ToUniversalTime(), EndTime = value.EndTime.ToUniversalTime() };
        Applying = true;
        try
        {
            await ValueChanged.InvokeAsync(value);
            if (Disposed || JavaScriptManaged) return false;
            Value = value;
            return true;
        }
        finally
        {
            Applying = false;
            if (!Disposed) await InvokeAsync(StateHasChanged);
        }
    }

    async ValueTask DisposePickerAsync()
    {
        if (Picker is null) return;
        var picker = Picker;
        Picker = null;
        await picker.InvokeVoidAsync("dispose");
        await picker.DisposeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        Disposed = true;
        await LifecycleLock.WaitAsync();
        try
        {
            await DisposePickerAsync();
            if (JsModule is not null) await JsModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally
        {
            CallbackReference?.Dispose();
            LifecycleLock.Release();
        }
    }
}
