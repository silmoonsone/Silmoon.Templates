<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The package metadata. Fill in the properties marked as TODO below -->
    <!-- Follow the instructions on https://learn.microsoft.com/en-us/nuget/create-packages/package-authoring-best-practices -->

    <!-- Keep package type as 'Template' to show the package as a template package on nuget.org and make your template available in dotnet new search.-->
    <PackageType>Template</PackageType>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Silmoon.Templates</PackageId>
    <Version>3.3.0-alpha</Version>
    <Authors>SILMOON</Authors>
    <Company>SILMOON LLC</Company>
    <Description>Silmoon templates</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/silmoonsone/Silmoon.Templates</PackageProjectUrl>
    <RepositoryUrl>https://github.com/silmoonsone/Silmoon.Templates.git</RepositoryUrl>
    <PackageTags>silmoon;ffweb;template</PackageTags>
    <LocalizeTemplates>false</LocalizeTemplates>
    <PackageOutputPath>..\packages_out</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TemplateEngine.Tasks" Version="*" PrivateAssets="all" IsImplicitlyDefined="true" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="content\**\*" />

    <!-- Build and test output -->
    <Content Remove="content\**\bin\**" />
    <Content Remove="content\**\obj\**" />
    <Content Remove="content\**\publish\**" />
    <Content Remove="content\**\artifacts\**" />
    <Content Remove="content\**\TestResults\**" />

    <!-- Restored dependencies -->
    <Content Remove="content\**\wwwroot\lib\**" />
    <Content Remove="content\**\node_modules\**" />

    <!-- Keys and publishing credentials -->
    <Content Remove="content\**\DataProtection\**" />
    <Content Remove="content\**\*.pfx" />
    <Content Remove="content\**\*.p12" />
    <Content Remove="content\**\*.key" />
    <Content Remove="content\**\*.pem" />
    <Content Remove="content\**\*.pubxml" />
    <Content Remove="content\**\*.publishsettings" />

    <!-- Local configuration and notes -->
    <Content Remove="content\**\.env" />
    <Content Remove="content\**\.env.local" />
    <Content Remove="content\**\.env.*.local" />
    <Content Remove="content\**\config.local*.json" />
    <Content Remove="content\**\*.local.*" />
    <Content Remove="content\**\*.local-log.db*" />
    <Content Remove="content\**\local.json" />
    <Content Remove="content\**\local.md" />
    <Content Remove="content\**\*-local.json" />
    <Content Remove="content\**\*-local.md" />

    <!-- Version control and IDE files -->
    <Content Remove="content\**\.git" />
    <Content Remove="content\**\.git\**" />
    <Content Remove="content\**\.vs\**" />
    <Content Remove="content\**\.idea\**" />
    <Content Remove="content\**\*.user" />
    <Content Remove="content\**\*.suo" />
    <Content Remove="content\**\*.rsuser" />
    <Content Remove="content\**\.DS_Store" />

    <!-- Temporary files, logs and packages -->
    <Content Remove="content\**\*.tmp" />
    <Content Remove="content\**\*.bak" />
    <Content Remove="content\**\*.log" />
    <Content Remove="content\**\*.binlog" />
    <Content Remove="content\**\*.nupkg" />
    <Content Remove="content\**\*.snupkg" />

    <Compile Remove="**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
